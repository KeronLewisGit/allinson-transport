APP_NAME="Allinson Transport"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.allinsontransport.co.uk
APP_TIMEZONE=Europe/London
APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_allinson
DB_USERNAME=u000000000_allinson
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail.
# allinsontransport.co.uk mail is on Microsoft 365 (MX allinsontransport-co-uk.mail.protection.outlook.com), so send
# through a licensed M365 mailbox with SMTP AUTH enabled, or add Hostinger to the SPF record first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@allinsontransport.co.uk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@allinsontransport.co.uk
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Set false at launch.
ALLINSON_PREVIEW=false
# Public email shown on the site (default info@allinsontransport.co.uk).
ALLINSON_PUBLIC_EMAIL=info@allinsontransport.co.uk
# Who is emailed about new submissions, comma separated. Each area falls back to ALLINSON_NOTIFY_EMAIL.
ALLINSON_NOTIFY_EMAIL=
ALLINSON_NOTIFY_QUOTES=
ALLINSON_NOTIFY_WAREHOUSING=
ALLINSON_NOTIFY_RECRUITMENT=
# Daily driver card and CPC expiry digest (falls back to ALLINSON_NOTIFY_EMAIL).
ALLINSON_NOTIFY_COMPLIANCE=
ALLINSON_NOTIFY_ENQUIRIES=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
